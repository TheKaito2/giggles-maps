          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบใบหน้าในเซลฟี่"
          }
        }
      }
    },
    "We need your location to check in. Allow location access in Settings and try again.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องใช้ตำแหน่งเพื่อเช็คอิน เปิดสิทธิ์ตำแหน่งในการตั้งค่าแล้วลองอีกครั้ง"
          }
        }
      }
    },
    "We only check that a face is in the photo. No face recognition.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราตรวจแค่ว่ามีใบหน้าในรูป ไม่มีการจดจำใบหน้า"
          }
        }
      }
    },
    "You can delete your account and all check-ins any time in Passport.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณลบบัญชีและการเช็คอินทั้งหมดได้ทุกเมื่อในพาสปอร์ต"
          }
        }
      }
    },
    "You moved faster than a car since your last check-in.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเคลื่อนที่เร็วกว่ารถยนต์นับจากเช็คอินครั้งก่อน"
          }
        }
      }
    },
    "You're more than 60 m from this place.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
