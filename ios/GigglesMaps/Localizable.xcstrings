  "strings": {
    "%@ · %lld m away": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · ห่างไป %2$lld ม."
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld นาที"
          }
        }
      }
    },
    "%lld minutes": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld นาที"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld จาก %2$lld"
          }
        }
      }
    },
    "%lld stops · trip %lld min instead of %lld": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld จุดแวะ · ใช้เวลา %2$lld นาที แทน %3$lld นาที"
          }
        }
      }
