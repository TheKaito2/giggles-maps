      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld นาที"
          }
        }
      }
    },
    "Account deleted. A fresh guest passport starts next time you plan a route.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบบัญชีแล้ว พาสปอร์ตใหม่จะเริ่มเมื่อคุณวางแผนเส้นทางครั้งถัดไป"
          }
        }
      }
    },
    "Already stamped here today. Come back tomorrow.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันนี้ได้ตราประทับที่นี่แล้ว พรุ่งนี้มาใหม่นะ"
          }
        }
      }
    },
    "Art": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ศิลปะ"
          }
        }
      }
    },
    "Ask the counter or scan the sticker with your camera.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามที่เคาน์เตอร์ หรือสแกนสติกเกอร์ด้วยกล้อง"
          }
        }
      }
    },
    "Business view: %@%@.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมมองธุรกิจ: %1$@%2$@"
          }
        }
      }
    },
    "Business view: partners on this route pay about ฿%.2f in expected visit fees.": {
      "localizations": {
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมมองธุรกิจ: พาร์ทเนอร์บนเส้นทางนี้จ่ายค่าเยี่ยมชมโดยประมาณ ฿%.2f"
          }
        }
      }
    },
